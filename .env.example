# ==========================================================
# Saraswati Sweets - Environment Variables Configuration
# ==========================================================

# GEMINI_API_KEY: Optional for future assistant or smart catalog enrichment
GEMINI_API_KEY=""

# APP_URL: The public URL of the application
APP_URL="http://localhost:3000"

# --- Client-Side Supabase Configuration (Public) ---
# Project URL from Supabase dashboard (Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public API Key (safe for browser)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Server-Side Only Credentials (NEVER expose to client!) ---
# Supabase Service Role Key: used by server layer for privileged operations (RLS bypass)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Payment Gateway Credentials (Server-side order creation & webhook verification)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_key"

# Server configuration
PORT=3000
NODE_ENV="development"
