# ==========================================================
# Saraswati Sweets - Environment Variables Configuration
# ==========================================================

# GEMINI_API_KEY: Optional for future assistant or smart catalog enrichment
GEMINI_API_KEY=""

# APP_URL: The public URL of the application
APP_URL="http://localhost:3000"

# --- Client-Side Supabase Configuration (Public) ---
# Project URL from Supabase dashboard (Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public API Key (safe for browser)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Server-Side Only Credentials (NEVER expose to client!) ---
# Supabase Service Role Key: used by server layer for privileged operations (RLS bypass)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cashfree Payment Gateway Credentials (Server-side order creation & webhook verification)
CASHFREE_APP_ID="test_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret"
CASHFREE_ENVIRONMENT="SANDBOX"

# --- Zoho ZeptoMail Configuration (Transactional Email) ---
# ZeptoMail Send Mail Token (India region: api.zeptomail.in)
ZEPTOMAIL_API_KEY="Zoho-enczapikey your_zeptomail_send_mail_token"

# ZeptoMail Template Key for Customer Order Confirmation
ZEPTOMAIL_TEMPLATE_KEY="your_zeptomail_template_key"

# Verified sender address and display name (defaults to order@saraswatisweets.in / Saraswati Sweets)
ZEPTOMAIL_FROM_ADDRESS="order@saraswatisweets.in"
ZEPTOMAIL_FROM_NAME="Saraswati Sweets"

# Zoho ZeptoMail base URL (defaults to https://cpaas.zoho.in)
ZEPTOMAIL_BASE_URL="https://cpaas.zoho.in"

# Server configuration
# Local development default: PORT=3000, NODE_ENV="development"
# Railway production: PORT is dynamically provided by Railway (or set to match Railway Networking Port, e.g. 8080). NODE_ENV="production"
PORT=3000
NODE_ENV="development"
